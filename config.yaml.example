# Copy this file to config.yaml and edit for your setup.
# For participant kits, the defaults below are correct - the only per-device
# config is /boot/firmware/obd-ev-wifi.conf and /etc/default/obd-ev.

obd:
  port: /dev/rfcomm0      # set by obd-ev-pair.service at boot
  baudrate: 38400
  fast: false             # required for most ELM327 BT clones on the Pi
  timeout: 30
  reconnect_seconds: 15   # retry interval if the adapter isn't ready yet
  # Core PIDs always attempted. Anything else the car reports as supported
  # is added automatically.
  core_pids:
    - RPM
    - SPEED
    - THROTTLE_POS
    - COOLANT_TEMP
    - ENGINE_LOAD

gps:
  enabled: true
  host: 127.0.0.1
  port: 2947              # gpsd default

imu:
  enabled: true
  i2c_address: 0x68
  sample_hz: 100
  lowpass_alpha: 0.1      # 0..1, lower = smoother but more lag

logger:
  output_dir: ./logs
  rotate_each_run: true   # one CSV per startup, named with timestamp
  flush_every: 10         # rows
  # Uploaded files are moved here so we don't re-upload them. Cleared
  # manually when the device returns from a participant.
  uploaded_subdir: uploaded

# Each device gets a tag stored in every CSV row so logs from many
# participants don't get mixed up after upload. Set per-device in
# /etc/default/obd-ev (env var OBD_EV_DEVICE_ID); falls back to hostname.
device:
  id: null
