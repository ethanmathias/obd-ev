[Unit]
Description=obd-ev first-boot WiFi provisioning
After=NetworkManager.service
ConditionPathExists=|/boot/firmware/obd-ev-wifi.conf
ConditionPathExists=|/boot/obd-ev-wifi.conf

[Service]
Type=oneshot
ExecStart=/home/pi/obd-ev/scripts/firstboot_wifi.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
