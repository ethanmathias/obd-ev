[Unit]
Description=Periodically upload obd-ev CSV logs

[Timer]
# Try shortly after boot (Pi just connected to home WiFi)...
OnBootSec=1min
# ...and every minute while the Pi is up. Each run is a no-op if there's
# nothing pending or no internet.
OnUnitActiveSec=1min
Persistent=true
Unit=obd-ev-upload.service

[Install]
WantedBy=timers.target
