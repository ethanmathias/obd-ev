[Unit]
Description=Bind paired ELM327 OBD adapter to /dev/rfcomm0
After=bluetooth.service
Requires=bluetooth.service
Before=obd-ev.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/python3 /home/pi/obd-ev/scripts/obd_pair.py
RemainAfterExit=yes
# Don't fail the whole boot if the OBD adapter isn't plugged in yet -
# the main service will retry connecting.
SuccessExitStatus=0 2

[Install]
WantedBy=multi-user.target
