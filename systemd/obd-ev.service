[Unit]
Description=obd-ev vehicle data logger
After=network.target bluetooth.service obd-ev-pair.service gpsd.service
Wants=obd-ev-pair.service gpsd.service

[Service]
Type=simple
User=@INSTALL_USER@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=-/etc/default/obd-ev
ExecStart=@VENV_DIR@/bin/python -m obd_ev.main --config @REPO_DIR@/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
