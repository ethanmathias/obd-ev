# Drop this file (renamed to `obd-ev-wifi.conf`) onto the BOOT partition of
# the SD card before first boot. Each block describes one network. The Pi will
# auto-connect to whichever is in range.
#
# Lines starting with # are ignored. Blank lines are fine. Separate networks
# with a line of three dashes.

ssid=MyHomeWiFi
psk=mypassword

---

ssid=Backup
psk=otherpassword
